{
  "name": "pocketwise",
  "version": "1.0.0",
  "description": "A cross-platform student finance app built with Expo and Supabase.",
  "keywords": [
    "expo",
    "react-native",
    "supabase",
    "student-budget",
    "personal-finance"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:timezones": "node scripts/test-timezones.cjs",
    "export": "node scripts/export.cjs",
    "check": "npm run lint -- --max-warnings 0 && npm run typecheck && npm run types:database:check && npm test && npm run test:database && npm run test:legacy && npm run export:demo",
    "typecheck": "tsc --noEmit",
    "test:database": "node scripts/test-database.cjs",
    "test:e2e": "playwright test",
    "export:demo": "node scripts/export.cjs --demo",
    "lint": "expo lint",
    "types:database": "node scripts/generate-database-types.cjs",
    "types:database:check": "node scripts/generate-database-types.cjs --check",
    "test:legacy": "node scripts/rehearse-legacy.cjs",
    "test:integration": "node integration/supabase.test.cjs",
    "profile:finance": "node scripts/profile-finance.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "@supabase/supabase-js": "^2.109.0",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~57.0.26",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/dist-demo/",
      "/e2e/",
      "/RaportoDemo/",
      "/integration/"
    ]
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "uuid": "11.1.1"
  },
  "private": true
}
